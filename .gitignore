# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# NOTE: all of public/ is ignored, but files committed before this rule (icons,
# og-image, flags, hero.mp4) stay tracked because git only ignores UNTRACKED
# files. Any NEW asset must be added with `git add -f` or the production build
# will not see it — next/font/local resolves font files at compile time, so a
# missing one fails the build outright rather than 404ing.
public/
public/*
.env*.local

# Contentsquare wizard verification reports
.cs-wizard/
